# SpacECE YouTube Automation — Environment Configuration
# Copy this file to .env and fill in your actual values

# ─── AI Provider (Groq only for v1) ────────────────────────────────────────
GROQ_API_KEY=

# ─── Free Local TTS (Piper) ────────────────────────────────────────────────
PIPER_BINARY_PATH=./tools/piper/piper
PIPER_VOICE_MODEL=./models/piper-voices/en_US-lessac-high.onnx

# ─── FFmpeg (optional override; resolution order: FFMPEG_PATH > bundled ffmpeg-static > system PATH)
# FFMPEG_PATH=

# ─── Application Settings ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3456
LOG_LEVEL=info

# ─── Channel Settings ─────────────────────────────────────────────────────
CHANNEL_NAME=Your Channel Name
DEFAULT_AUTHOR=Your Name
TARGET_AUDIENCE=Parents and educators interested in early childhood education

# ─── YouTube Settings ─────────────────────────────────────────────────────
YOUTUBE_REGION=US
DEFAULT_PRIVACY_STATUS=private

# ─── Content Settings ─────────────────────────────────────────────────────
AUTO_SHORTEN_CONTENT=true
AUTO_ADD_BACKLINKS=true
PRESERVE_FORMATTING=true
AUTO_RESIZE_IMAGES=true
MAX_IMAGE_WIDTH=1280
MAX_IMAGE_HEIGHT=720
IMAGE_QUALITY=90

# ─── Video Settings (slideshow-only for v1) ────────────────────────────────
VIDEO_PROVIDER=slideshow
VIDEO_PROVIDER_ORDER=slideshow
VIDEO_VISUAL_SOURCE=stock

# ─── Stock Footage API Keys ────────────────────────────────────────────────
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ─── Rate Limiting ────────────────────────────────────────────────────────
GLOBAL_RATE_LIMIT_PER_HOUR=50
DEFAULT_DELAY_BETWEEN_POSTS=60000

# ─── Security ─────────────────────────────────────────────────────────────
# Optional. If set, mutating API routes require this value in the x-api-key header.
API_KEY=

# ─── Analytics & Monitoring ───────────────────────────────────────────────
ENABLE_ANALYTICS=true

# ─── File Upload Settings ─────────────────────────────────────────────────
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# ─── Error Handling ───────────────────────────────────────────────────────
RETRY_ATTEMPTS=3
RETRY_DELAY=5000
