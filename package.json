  "description": "SpacECE YouTube Automation Pipeline — 7-agent content pipeline with Groq AI and slideshow video rendering",
  "main": "run-pipeline.js",
  "scripts": {
    "start": "node run-pipeline.js",
    "setup": "node setup.js",
