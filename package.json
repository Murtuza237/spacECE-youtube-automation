    "form-data": "^4.0.4",
    "googleapis": "^173.0.0",
    "inquirer": "^8.2.6",
    "openai": "^6.0.0",
    "playwright": "^1.63.0",
    "replicate": "^1.4.0",
    "sharp": "^0.33.0",
    "winston": "^3.11.0"
